# Copy this file to .env for local testing with `vercel dev` (never commit the real .env).
# In production, set these in the Vercel dashboard: Project → Settings → Environment Variables.

# From resend.com → API Keys, after verifying a sending domain (or subdomain) there.
RESEND_API_KEY=

# Where booking request emails are sent.
