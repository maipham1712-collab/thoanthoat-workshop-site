# Copy this file to .env for local testing with `vercel dev` (never commit the real .env).
# In production, set these in the Vercel dashboard: Project → Settings → Environment Variables.

# From resend.com → API Keys, after verifying a sending domain (or subdomain) there.
RESEND_API_KEY=

# Where booking request emails are sent. Comma-separated for more than one address.
NOTIFY_EMAIL=maipham1712@gmail.com

# Must be an address on a domain verified in Resend, e.g. bookings@thoanthoatws.vietjewelers.com
FROM_EMAIL=Thoăn Thoắt <bookings@thoanthoatws.vietjewelers.com>
